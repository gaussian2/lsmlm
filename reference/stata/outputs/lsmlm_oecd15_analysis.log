>     using "$OUT/table1_two_break.dta", replace
(file C:\Users\ibrah\OneDrive\Masaüstü\lsmlm\outputs/table1_two_break.dta not found)

. 
. foreach i of local cids {
  2.     quietly levelsof country if cid==`i', local(cn) clean
  3.     di as txt "  running: " as res "`cn'" _continue
  4. 
.     preserve
  5.         quietly keep if cid==`i'
  6.         quietly tsset year, yearly
  7.         capture quietly lsmlm y, breaks(2) model(break) ///
>             maxlag(`MAXLAG') mindist(`MINDIST') trim(`TRIM')
  8.         local rc = _rc
  9.         if `rc' == 0 {
 10.             post `P1' ("`cn'") (r(N)) (r(k)) (r(tb1)) (r(tb2)) ///
>                 (r(lambda1)) (r(lambda2)) (r(tau)) ///
>                 (r(cv1)) (r(cv5)) (r(cv10)) ///
>                 (r(reject1)) (r(reject5)) (r(reject10)) ///
>                 (r(break1_sig10)) (r(break2_sig10)) ///
>                 (r(tB1)) (r(tD1)) (r(tB2)) (r(tD2))
 11.         }
 12.     restore
 13. 
.     if `rc' == 0  di as txt "  done"
 14.     else          di as err "  FAILED (rc=`rc')"
 15.     if `rc' != 0 {
 16.         post `P1' ("`cn'") (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) ///
>             (.) (.) (.) (.) (.) (.) (.) (.) (.)
 17.     }
 18. }
  running: France  done
  running: United Kingdom  done
  running: United States  done

