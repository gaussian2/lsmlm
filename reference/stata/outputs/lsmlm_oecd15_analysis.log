. tempname P1

. postfile `P1' str32 country int N byte k int tb1 int tb2 ///
>     double lambda1 double lambda2 double tau ///
>     double cv1 double cv5 double cv10 ///
>     byte rej1 byte rej5 byte rej10 ///
>     byte b1sig byte b2sig ///
